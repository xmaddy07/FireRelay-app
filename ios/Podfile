# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Firebase iOS SDK still needs static frameworks; RNFB pods are linked as static
# libraries below to avoid "non-modular header inside framework module" with prebuilt RN.
$RNFirebaseAsStaticFramework = false

RNFB_STATIC_LIBRARY_PODS = %w[RNFBApp RNFBMessaging].freeze

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
else
  use_frameworks! :linkage => :static
end

pre_install do |installer|
  installer.pod_targets.each do |pod|
    next unless RNFB_STATIC_LIBRARY_PODS.include?(pod.name)

    Pod::UI.puts "Linking #{pod.name} as static library (RN + Firebase workaround)".green
    def pod.build_type
      Pod::BuildType.static_library
    end
  end
end

target 'FireRelay' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported

        if RNFB_STATIC_LIBRARY_PODS.include?(target.name)
          build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
          other_cflags = build_config.build_settings['OTHER_CFLAGS'] || '$(inherited)'
          unless other_cflags.to_s.include?('-Wno-non-modular-include-in-framework-module')
            build_config.build_settings['OTHER_CFLAGS'] = "#{other_cflags} -Wno-non-modular-include-in-framework-module"
          end
        end
      end
    end

    # react-native-sound (RNSound) uses AVAudioPlayer/AVAudioSession but its podspec
    # does not declare AVFoundation, which causes undefined symbol linker errors.
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.xcconfigs.each do |config_name, _config_file|
        xcconfig_path = aggregate_target.xcconfig_path(config_name)
        xcconfig = File.read(xcconfig_path)
        next if xcconfig.include?('AVFoundation')

        xcconfig.gsub!(
          /^(OTHER_LDFLAGS = .*)$/,
          '\1 -framework "AVFoundation"'
        )
        File.write(xcconfig_path, xcconfig)
      end
    end
  end
end
